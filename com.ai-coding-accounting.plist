<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai-coding-accounting</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>REPLACE_ME_PROJECT_DIR/start.sh</string>
    </array>
    
    <key>WorkingDirectory</key>
    <string>REPLACE_ME_PROJECT_DIR</string>
    
    <key>RunAtLoad</key>
    <false/>
    
    <key>KeepAlive</key>
    <true/>
    
    <key>StandardOutPath</key>
    <string>REPLACE_ME_PROJECT_DIR/logs/service.log</string>
    
    <key>StandardErrorPath</key>
    <string>REPLACE_ME_PROJECT_DIR/logs/service.error.log</string>
    
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
